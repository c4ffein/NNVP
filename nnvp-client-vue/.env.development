# Loaded by vite in dev mode only (committed on purpose; use .env.*.local for
# personal overrides). Production builds must set this explicitly — a build
# without it disables the cloud-account UI entirely (static-only deploy).
#
# Dev expects a backend on :8000 (`make backend` at the repo root); vite
# proxies same-origin /api to it (see vite.config.js).
VITE_ENABLE_BACKEND=1
