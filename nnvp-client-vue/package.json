{
  "name": "nnvp-client-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-host": "vite --host",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:bun": "PW_DISABLE_TS_ESM=1 playwright test",
    "test:e2e:fast": "playwright test --workers=4",
    "test:e2e:debug": "playwright test --workers=1",
    "test:e2e:xvfb": "xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:contract": "bun test tests/contract --timeout 15000",
    "lint": "oxlint src tests",
    "typecheck": "tsc",
    "test:fast": "bun test tests/fast",
    "lint:fix": "oxlint src tests --fix"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vue-flow/core": "1.48.2",
    "file-saver": "^2.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/test-utils": "^2.4.11",
    "oxlint": "^1.24.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.1"
  }
}
