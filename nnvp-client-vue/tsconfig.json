{
  // Gradual TypeScript adoption (docs/tasks.md § 6): .ts files and lang="ts"
  // SFC script blocks are strictly checked; plain-JS files and script blocks
  // ride along unchecked (allowJs + checkJs:false) and convert
  // opportunistically. `bun run typecheck` runs vue-tsc through
  // scripts/vue-tsc-bun.js (vue-tsc's own bin silently skips .vue under bun —
  // see that script's header); `bun run typecheck:tsc` is the plain-tsc
  // fallback, which does NOT check .vue contents. Keep typescript pinned to
  // 5.x — vue-tsc breaks with typescript@7.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // GeneralMenu.vue's lang="tsx" render function: vue-tsc refuses JSX
    // without --jsx, and "preserve" + jsxImportSource "vue" is Vue's
    // recommended pairing (vite's plugin-vue-jsx does the actual transform).
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.vue", "tests/**/*.ts", "tests/**/*.js"]
}
